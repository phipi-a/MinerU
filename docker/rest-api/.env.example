# Copy to docker/rest-api/.env and pass it explicitly with --env-file.
MINERU_BIND_ADDRESS=127.0.0.1
MINERU_PORT=8000
MINERU_API_KEY=
NVIDIA_GPU_ID=0
MINERU_SERVER_TIER=standard
MINERU_SERVER_CONCURRENCY=1
MINERU_SERVER_PRELOAD=0
# 0 keeps images/charts as images in Advanced; 1 adds VLM chart tables and image-to-table conversion.
MINERU_SERVER_IMAGE_ANALYSIS=0
MINERU_API_RETENTION_SECONDS=86400
MINERU_CPU_NUM_THREADS=8
MINERU_MODEL_SOURCE=huggingface
# Optional: Hugging Face token for model downloads.
HF_TOKEN=
# Optional: use another compatible vLLM image for your GPU and driver.
# MINERU_BASE_IMAGE=vllm/vllm-openai:v0.21.0-cu129
